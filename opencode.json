{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "jq*": "allow",
      "sort*": "allow",
      "xargs*": "allow",
      "mkdir*": "allow",
      "find*": "allow",
      "cat*": "allow",
      "echo*": "allow",
      "sleep*": "allow",
      "tree*": "allow",
      "wc*": "allow",
      "tail*": "allow",
      "head*": "allow",
      "grep*": "allow",
      "ps*": "allow",
      "*tsc*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git grep*": "allow",
      "gh repo view*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "rm *": "ask"
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "oh-my-opencode-slim"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "docs-rs": {
      "type": "local",
      "command": [
        "npx",
        "@nuskey8/docs-rs-mcp@latest",
        "-y"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {}
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
